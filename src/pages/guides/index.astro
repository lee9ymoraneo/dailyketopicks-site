---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const guides = [
  { title: 'Keto Diet Basics', description: 'Learn the fundamentals of the ketogenic diet.', icon: '📚', slug: 'keto-diet-basics' },
  { title: 'Keto Meal Planning', description: 'How to plan your keto meals for success.', icon: '📅', slug: 'keto-meal-planning' },
  { title: 'Keto Shopping Guide', description: 'What to buy at the grocery store.', icon: '🛒', slug: 'keto-shopping-guide' },
  { title: 'Keto for Beginners', description: 'Everything you need to know to start.', icon: '🚀', slug: 'keto-for-beginners' },
  { title: 'Keto Mistakes to Avoid', description: 'Common pitfalls and how to avoid them.', icon: '⚠️', slug: 'keto-mistakes-to-avoid' },
  { title: 'Keto Success Tips', description: 'Expert tips for long-term success.', icon: '✅', slug: 'keto-success-tips' },
];
---

<Base title="Keto Guides - Daily Keto Picks" description="Comprehensive guides to help you succeed on your keto journey.">
  <Header />

  <main class="main">
    <section class="page-header">
      <div class="container">
        <h1>Keto Guides</h1>
        <p>Comprehensive guides to help you succeed on your keto journey.</p>
      </div>
    </section>

    <section class="content">
      <div class="container">
        <div class="guides-grid">
          {guides.map(guide => (
            <a href={`/posts/${guide.slug}`} class="guide-card glass-card">
              <span class="guide-icon">{guide.icon}</span>
              <h2>{guide.title}</h2>
              <p>{guide.description}</p>
              <span class="guide-link">Read Guide →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .main { flex: 1; padding-top: 80px; }

  .page-header {
    background: var(--color-bg-secondary);
    padding: 3rem 0;
    text-align: center;
    border-bottom: 1px solid var(--glass-border);
  }

  .page-header h1 { font-size: 2.5rem; margin-bottom: 0.5rem; }
  .page-header p { color: var(--color-text-secondary); font-size: 1.1rem; }

  .content { padding: 3rem 0; }

  .guides-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .guide-card {
    padding: 2rem;
    text-decoration: none;
    transition: all var(--transition-base);
  }

  .guide-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-primary);
  }

  .guide-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    display: block;
  }

  .guide-card h2 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }

  .guide-card p {
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
  }

  .guide-link {
    color: var(--color-primary-light);
    font-weight: 500;
  }
</style>

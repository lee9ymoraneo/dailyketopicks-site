---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Base title="Terms of Service - DeskHiker" description="Terms and conditions for using our website.">
  <Header />

  <main class="main">
    <section class="page-header">
      <div class="container">
        <h1>Terms of Service</h1>
        <p>Last updated: January 1, 2024</p>
      </div>
    </section>

    <section class="content">
      <div class="container content-width">
        <div class="legal-content">
          <h2>Acceptance of Terms</h2>
          <p>By accessing and using DeskHiker, you accept and agree to be bound by these Terms of Service.</p>

          <h2>Intellectual Property</h2>
          <p>The Website and its original content, features, and functionality are owned by DeskHiker and are protected by international copyright, trademark, patent, trade secret, and other intellectual property laws.</p>

          <h2>User Content</h2>
          <p>When you submit content to our Website (such as comments), you grant us the right to use, modify, and display such content.</p>

          <h2>Disclaimer</h2>
          <p>Your use of our Website is at your sole risk. The Website is provided on an "AS IS" and "AS AVAILABLE" basis.</p>

          <h2>Contact Us</h2>
          <p>If you have any questions about these Terms, please contact us at <a href="mailto:legal@deskhiker.com">legal@deskhiker.com</a>.</p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .main { flex: 1; padding-top: 64px; }
  .page-header { background: var(--color-bg-secondary); padding: 3rem 0; text-align: center; border-bottom: 1px solid var(--glass-border); }
  .page-header h1 { font-size: 2.5rem; margin-bottom: 0.5rem; }
  .page-header p { color: var(--color-text-secondary); }
  .content { padding: 3rem 0; }
  .legal-content h2 { font-size: 1.5rem; margin: 2rem 0 1rem; }
  .legal-content h2:first-child { margin-top: 0; }
  .legal-content p { margin-bottom: 1rem; line-height: 1.8; }
</style>

---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Base title="Privacy Policy - DeskHiker" description="Our privacy policy explains how we collect and use your information.">
  <Header />

  <main class="main">
    <section class="page-header">
      <div class="container">
        <h1>Privacy Policy</h1>
        <p>Last updated: January 1, 2024</p>
      </div>
    </section>

    <section class="content">
      <div class="container content-width">
        <div class="legal-content">
          <h2>Introduction</h2>
          <p>Welcome to DeskHiker ("we," "our," or "us"). We are committed to protecting your personal information and your right to privacy.</p>

          <h2>Information We Collect</h2>
          <p>We may collect information about you in various ways, including:</p>
          <ul>
            <li><strong>Personal Data:</strong> Name, email address, and other contact information you voluntarily provide.</li>
            <li><strong>Derivative Data:</strong> Information our servers automatically collect when you access our site.</li>
            <li><strong>Cookies:</strong> We use cookies to track activity on our service.</li>
          </ul>

          <h2>How We Use Your Information</h2>
          <p>We may use the information we collect to:</p>
          <ul>
            <li>Provide and maintain our website</li>
            <li>Notify you about changes to our website</li>
            <li>Provide customer support</li>
            <li>Gather analysis to improve our website</li>
            <li>Send you newsletters (with your consent)</li>
          </ul>

          <h2>Contact Us</h2>
          <p>If you have any questions about this Privacy Policy, please contact us at <a href="mailto:privacy@deskhiker.com">privacy@deskhiker.com</a>.</p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .main { flex: 1; padding-top: 64px; }
  .page-header { background: var(--color-bg-secondary); padding: 3rem 0; text-align: center; border-bottom: 1px solid var(--glass-border); }
  .page-header h1 { font-size: 2.5rem; margin-bottom: 0.5rem; }
  .page-header p { color: var(--color-text-secondary); }
  .content { padding: 3rem 0; }
  .legal-content h2 { font-size: 1.5rem; margin: 2rem 0 1rem; }
  .legal-content h2:first-child { margin-top: 0; }
  .legal-content p { margin-bottom: 1rem; line-height: 1.8; }
  .legal-content ul { margin: 1rem 0; padding-left: 1.5rem; }
  .legal-content li { margin-bottom: 0.5rem; line-height: 1.8; }
</style>

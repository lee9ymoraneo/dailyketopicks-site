---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const allPosts = await getCollection('posts');
const relatedPosts = allPosts
  .filter(p => p.id !== post.id && p.data.category === post.data.category)
  .slice(0, 3);

const postImages = {
  'best-hiking-boots-for-beginners-in-2024': 'https://images.unsplash.com/photo-1551632811-561732d1e306?w=1200&h=600&fit=crop',
  'top-10-hiking-trails-in-colorado': 'https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=1200&h=600&fit=crop',
  'complete-camping-checklist-for-beginners': 'https://images.unsplash.com/photo-1504280390367-361c6d9f38f4?w=1200&h=600&fit=crop',
};

const categoryImages = {
  'Hiking': 'https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=1200&h=600&fit=crop',
  'Camping': 'https://images.unsplash.com/photo-1504280390367-361c6d9f38f4?w=1200&h=600&fit=crop',
  'Backpacking': 'https://images.unsplash.com/photo-1551632811-561732d1e306?w=1200&h=600&fit=crop',
  'Outdoor Gear': 'https://images.unsplash.com/photo-1551632811-561732d1e306?w=1200&h=600&fit=crop',
  'Travel': 'https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=1200&h=600&fit=crop',
};

const postImage = postImages[post.id] || categoryImages[post.data.category] || 'https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=1200&h=600&fit=crop';
---

<Base title={`${post.data.title} - DeskHiker`} description={post.data.description} article={true}>
  <Header />

  <main class="main">
    <section class="article-hero">
      <div class="hero-image">
        <img src={postImage} alt={post.data.title} />
        <div class="hero-overlay"></div>
      </div>
      <div class="container hero-content">
        <a href={`/category/${post.data.category.toLowerCase().replace(/\s+/g, '-')}`} class="article-category">
          {post.data.category}
        </a>
        <h1>{post.data.title}</h1>
        <div class="article-meta">
          <div class="author-info">
            <div class="author-avatar">
              <img src="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=100&h=100&fit=crop&crop=face" alt="Author" />
            </div>
            <div>
              <span class="author-name">{post.data.author}</span>
              <span class="publish-date">{post.data.pubDate}</span>
            </div>
          </div>
          <div class="article-tags">
            {post.data.tags.slice(0, 3).map(tag => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <article class="article-content">
      <div class="container content-width">
        <div class="content-body">
          <Content />
        </div>

        <div class="article-share">
          <span>Share this article:</span>
          <div class="share-buttons">
            <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(Astro.url.href)}`} target="_blank" rel="noopener noreferrer" class="share-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>
            <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(Astro.url.href)}`} target="_blank" rel="noopener noreferrer" class="share-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
            <a href={`https://www.pinterest.com/pin/create/button/?url=${encodeURIComponent(Astro.url.href)}&description=${encodeURIComponent(post.data.title)}`} target="_blank" rel="noopener noreferrer" class="share-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 01.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12.017 24c6.624 0 11.99-5.367 11.99-11.988C24.007 5.367 18.641 0 12.017 0z"/>
              </svg>
            </a>
          </div>
        </div>

        <div class="article-ad">
          <div class="ad-placeholder">
            <span>Advertisement</span>
          </div>
        </div>
      </div>
    </article>

    {relatedPosts.length > 0 && (
      <section class="related-posts">
        <div class="container">
          <h2>Related Articles</h2>
          <div class="related-grid">
            {relatedPosts.map(related => {
              const relatedImage = postImages[related.id] || categoryImages[related.data.category] || 'https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=400&h=250&fit=crop';
              return (
                <a href={`/posts/${related.id}`} class="related-card glass-card">
                  <div class="related-image">
                    <img src={relatedImage} alt={related.data.title} loading="lazy" />
                  </div>
                  <div class="related-content">
                    <span class="related-category">{related.data.category}</span>
                    <h3>{related.data.title}</h3>
                    <span class="related-date">{related.data.pubDate}</span>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      </section>
    )}
  </main>

  <Footer />
</Base>

<style>
  .main { flex: 1; padding-top: 64px; }

  .article-hero {
    position: relative;
    min-height: 500px;
    display: flex;
    align-items: flex-end;
    margin-bottom: 3rem;
  }

  .hero-image {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(15, 23, 42, 0.95) 0%, rgba(15, 23, 42, 0.5) 50%, rgba(15, 23, 42, 0.3) 100%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    padding-bottom: 3rem;
    width: 100%;
  }

  .article-category {
    display: inline-block;
    padding: 0.5rem 1.25rem;
    background: var(--color-primary);
    color: white;
    border-radius: 2rem;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 1.25rem;
    text-decoration: none;
  }

  .hero-content h1 {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    margin-bottom: 1.5rem;
    line-height: 1.15;
    color: white;
    max-width: 900px;
  }

  .article-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .author-info { display: flex; align-items: center; gap: 0.75rem; }
  .author-avatar { width: 48px; height: 48px; border-radius: 50%; overflow: hidden; border: 2px solid var(--color-primary); }
  .author-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .author-name { display: block; font-weight: 600; color: white; }
  .publish-date { display: block; font-size: 0.85rem; color: var(--color-text-secondary); }
  .article-tags { display: flex; gap: 0.5rem; }
  .article-tags .tag { background: rgba(255, 255, 255, 0.1); color: white; border: 1px solid rgba(255, 255, 255, 0.2); }

  .article-content { padding: 0 0 4rem; }
  .content-body { font-size: 1.15rem; line-height: 1.9; }

  .content-body :global(h2) { font-size: 1.75rem; margin: 3rem 0 1.5rem; color: var(--color-text); }
  .content-body :global(h3) { font-size: 1.35rem; margin: 2rem 0 1rem; color: var(--color-text); }
  .content-body :global(p) { margin-bottom: 1.5rem; color: var(--color-text-secondary); }
  .content-body :global(ul), .content-body :global(ol) { margin: 1.5rem 0; padding-left: 1.5rem; color: var(--color-text-secondary); }
  .content-body :global(li) { margin-bottom: 0.75rem; }
  .content-body :global(strong) { color: var(--color-text); font-weight: 600; }

  .article-share {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 2rem 0;
    border-top: 1px solid var(--glass-border);
    margin-top: 2rem;
  }

  .article-share span { color: var(--color-text-secondary); }
  .share-buttons { display: flex; gap: 0.75rem; }

  .share-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: 0.5rem;
    color: var(--color-text-secondary);
    transition: all var(--transition-fast);
  }

  .share-btn:hover { background: var(--color-primary); border-color: var(--color-primary); color: white; }

  .article-ad { margin-top: 2rem; }
  .ad-placeholder { background: rgba(34, 197, 94, 0.1); border: 2px dashed rgba(34, 197, 94, 0.3); border-radius: 0.75rem; padding: 2rem; text-align: center; color: var(--color-text-muted); }

  .related-posts { padding: 4rem 0; background: var(--color-bg-secondary); border-top: 1px solid var(--glass-border); }
  .related-posts h2 { margin-bottom: 2rem; }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .related-card {
    overflow: hidden;
    text-decoration: none;
    transition: all var(--transition-base);
  }

  .related-card:hover { transform: translateY(-4px); }

  .related-image { height: 180px; overflow: hidden; }
  .related-image img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .related-card:hover .related-image img { transform: scale(1.08); }
  .related-content { padding: 1.25rem; }
  .related-category { display: inline-block; padding: 0.25rem 0.625rem; background: rgba(34, 197, 94, 0.15); color: var(--color-primary-light); border-radius: 0.375rem; font-size: 0.75rem; font-weight: 500; margin-bottom: 0.5rem; }
  .related-card h3 { font-size: 1rem; margin-bottom: 0.5rem; color: var(--color-text); line-height: 1.4; }
  .related-date { font-size: 0.8rem; color: var(--color-text-muted); }

  @media (max-width: 768px) {
    .article-header h1 { font-size: 1.75rem; }
    .hero-image { min-height: 250px; }
    .article-meta { flex-direction: column; gap: 1rem; }
    .article-share { flex-direction: column; align-items: flex-start; }
  }
</style>

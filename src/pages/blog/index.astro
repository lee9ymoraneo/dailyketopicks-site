---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const allPosts = await getCollection('posts');
const posts = allPosts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

const postImages = {
  'best-hiking-boots-for-beginners-in-2024': 'https://images.unsplash.com/photo-1551632811-561732d1e306?w=400&h=300&fit=crop',
  'top-10-hiking-trails-in-colorado': 'https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=400&h=300&fit=crop',
  'complete-camping-checklist-for-beginners': 'https://images.unsplash.com/photo-1504280390367-361c6d9f38f4?w=400&h=300&fit=crop',
  'how-to-set-up-a-tent-step-by-step-guide': 'https://images.unsplash.com/photo-1504280390367-361c6d9f38f4?w=400&h=300&fit=crop',
  'best-backpacking-packs-under-200': 'https://images.unsplash.com/photo-1551632811-561732d1e306?w=400&h=300&fit=crop',
  'how-to-start-backpacking-complete-guide': 'https://images.unsplash.com/photo-1551632811-561732d1e306?w=400&h=300&fit=crop',
  'top-15-day-hikes-near-seattle': 'https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=400&h=300&fit=crop',
  'essential-camping-safety-tips': 'https://images.unsplash.com/photo-1504280390367-361c6d9f38f4?w=400&h=300&fit=crop',
  'best-national-parks-to-visit-in-2024': 'https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=400&h=300&fit=crop',
  'how-to-cook-while-camping': 'https://images.unsplash.com/photo-1504280390367-361c6d9f38f4?w=400&h=300&fit=crop',
};

const categoryImages = {
  'Hiking': 'https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=400&h=300&fit=crop',
  'Camping': 'https://images.unsplash.com/photo-1504280390367-361c6d9f38f4?w=400&h=300&fit=crop',
  'Backpacking': 'https://images.unsplash.com/photo-1551632811-561732d1e306?w=400&h=300&fit=crop',
  'Outdoor Gear': 'https://images.unsplash.com/photo-1551632811-561732d1e306?w=400&h=300&fit=crop',
  'Travel': 'https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=400&h=300&fit=crop',
};

const categories = [
  { name: 'All', slug: 'all', count: posts.length },
  { name: 'Hiking', slug: 'hiking', count: posts.filter(p => p.data.category === 'Hiking').length },
  { name: 'Camping', slug: 'camping', count: posts.filter(p => p.data.category === 'Camping').length },
  { name: 'Backpacking', slug: 'backpacking', count: posts.filter(p => p.data.category === 'Backpacking').length },
  { name: 'Outdoor Gear', slug: 'outdoor-gear', count: posts.filter(p => p.data.category === 'Outdoor Gear').length },
];
---

<Base title="All Guides - DeskHiker" description="Browse all our hiking, camping, and outdoor adventure guides.">
  <Header />

  <main class="main">
    <section class="page-header">
      <div class="container">
        <h1>All Guides</h1>
        <p>Browse our complete collection of {posts.length} adventure guides.</p>
      </div>
    </section>

    <section class="blog-content">
      <div class="container blog-layout">
        <div class="posts-list">
          {posts.map(post => {
            const postImage = postImages[post.id] || categoryImages[post.data.category] || 'https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=400&h=300&fit=crop';
            return (
            <article class="post-item glass-card">
              <div class="post-image">
                <img src={postImage} alt={post.data.title} loading="lazy" />
                <span class="post-category-badge">{post.data.category}</span>
              </div>
              <div class="post-content">
                <div class="post-meta">
                  <time>{post.data.pubDate}</time>
                </div>
                <h2><a href={`/posts/${post.id}`}>{post.data.title}</a></h2>
                <p>{post.data.description}</p>
                <div class="post-footer">
                  <div class="post-tags">
                    {post.data.tags.slice(0, 3).map(tag => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>
                  <a href={`/posts/${post.id}`} class="read-more">
                    Read article →
                  </a>
                </div>
              </div>
            </article>
          );
          })}
        </div>

        <aside class="sidebar">
          <div class="sidebar-widget glass-card">
            <h3>Categories</h3>
            <div class="category-list">
              {categories.map(category => (
                <a href={category.slug === 'all' ? '/blog' : `/category/${category.slug}`} class="category-item">
                  <span>{category.name}</span>
                  <span class="category-count">{category.count}</span>
                </a>
              ))}
            </div>
          </div>

          <div class="sidebar-widget glass-card">
            <div class="widget-icon">📬</div>
            <h3>Stay Connected</h3>
            <p>Get weekly adventure guides and gear reviews.</p>
            <form class="widget-form">
              <input type="email" placeholder="Your email" required />
              <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center;">Subscribe</button>
            </form>
          </div>

          <div class="sidebar-widget glass-card">
            <h3>Popular Guides</h3>
            <div class="popular-posts">
              {posts.slice(0, 5).map((post, index) => (
                <a href={`/posts/${post.id}`} class="popular-post">
                  <span class="popular-number">{String(index + 1).padStart(2, '0')}</span>
                  <div>
                    <h4>{post.data.title}</h4>
                    <span>{post.data.pubDate}</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </aside>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .main { flex: 1; padding-top: 80px; }

  .page-header {
    background: var(--color-bg-secondary);
    padding: 3rem 0;
    text-align: center;
    border-bottom: 1px solid var(--glass-border);
  }

  .page-header h1 { font-size: 2.5rem; margin-bottom: 0.5rem; }
  .page-header p { color: var(--color-text-secondary); font-size: 1.1rem; }

  .blog-content { padding: 3rem 0; }

  .blog-layout {
    display: grid;
    grid-template-columns: 1fr 350px;
    gap: 3rem;
  }

  .posts-list { display: flex; flex-direction: column; gap: 1.5rem; }

  .post-item {
    display: flex;
    gap: 1.5rem;
    overflow: hidden;
    transition: all var(--transition-base);
  }

  .post-item:hover { border-color: var(--color-primary); }

  .post-image {
    width: 220px;
    min-height: 160px;
    flex-shrink: 0;
    border-radius: 0.75rem;
    position: relative;
    overflow: hidden;
  }

  .post-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .post-item:hover .post-image img { transform: scale(1.05); }

  .post-category-badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background: var(--color-primary);
    padding: 0.25rem 0.625rem;
    border-radius: 0.375rem;
    font-size: 0.7rem;
    font-weight: 600;
    color: white;
    text-transform: uppercase;
  }

  .post-content { flex: 1; display: flex; flex-direction: column; }
  .post-meta { margin-bottom: 0.5rem; }
  .post-meta time { color: var(--color-text-muted); font-size: 0.85rem; }
  .post-content h2 { font-size: 1.35rem; margin-bottom: 0.75rem; line-height: 1.3; }
  .post-content h2 a { color: var(--color-text); }
  .post-content h2 a:hover { color: var(--color-primary-light); }
  .post-content p { color: var(--color-text-secondary); font-size: 0.95rem; flex: 1; }

  .post-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid var(--glass-border);
  }

  .post-tags { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .read-more { display: flex; align-items: center; gap: 0.375rem; color: var(--color-primary-light); font-weight: 500; font-size: 0.9rem; white-space: nowrap; }

  .sidebar { position: sticky; top: 100px; align-self: start; display: flex; flex-direction: column; gap: 1.5rem; }
  .sidebar-widget { padding: 1.5rem; }
  .sidebar-widget h3 { font-size: 1.1rem; margin-bottom: 1rem; }
  .widget-icon { font-size: 2rem; margin-bottom: 0.5rem; }
  .sidebar-widget p { color: var(--color-text-secondary); font-size: 0.9rem; margin-bottom: 1rem; }

  .category-list { display: flex; flex-direction: column; gap: 0.5rem; }

  .category-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.625rem 0.75rem;
    border-radius: 0.5rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .category-item:hover { background: rgba(34, 197, 94, 0.1); color: var(--color-primary-light); }
  .category-count { background: var(--glass-bg); padding: 0.25rem 0.625rem; border-radius: 1rem; font-size: 0.75rem; color: var(--color-text-muted); }

  .widget-form { display: flex; flex-direction: column; gap: 0.75rem; }
  .widget-form input { width: 100%; padding: 0.75rem 1rem; background: rgba(0, 0, 0, 0.3); border: 1px solid var(--glass-border); border-radius: 0.5rem; color: var(--color-text); font-size: 0.9rem; }
  .widget-form input:focus { outline: none; border-color: var(--color-primary); }

  .popular-posts { display: flex; flex-direction: column; gap: 1rem; }
  .popular-post { display: flex; gap: 1rem; padding-bottom: 1rem; border-bottom: 1px solid var(--glass-border); text-decoration: none; }
  .popular-post:last-child { border-bottom: none; padding-bottom: 0; }
  .popular-number { font-family: var(--font-heading); font-size: 1.25rem; font-weight: 800; color: var(--color-primary); opacity: 0.5; line-height: 1; }
  .popular-post h4 { font-size: 0.85rem; font-weight: 600; color: var(--color-text); margin-bottom: 0.25rem; line-height: 1.4; }
  .popular-post span { color: var(--color-text-muted); font-size: 0.75rem; }

  @media (max-width: 1024px) {
    .blog-layout { grid-template-columns: 1fr; }
    .sidebar { position: static; display: grid; grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 768px) {
    .post-item { flex-direction: column; }
    .post-image { width: 100%; min-height: 150px; }
    .sidebar { grid-template-columns: 1fr; }
  }
</style>
